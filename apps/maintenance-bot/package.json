{
  "name": "@publira/maintenance-bot",
  "version": "1.0.0",
  "private": true,
  "description": "Publira's maintenance jobs, deployed to Vercel with eve.",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "approve-equivalent-renovate-update": "node --env-file-if-exists=.env.local src/cli/approve-equivalent-renovate-update.ts",
    "auto-merge-renovate-update": "node --env-file-if-exists=.env.local src/cli/auto-merge-renovate-update.ts",
    "build": "eve build",
    "check-release-age-exclusions": "node --env-file-if-exists=.env.local src/cli/check-release-age-exclusions.ts",
    "close-completed-parent-issue": "node --env-file-if-exists=.env.local src/cli/close-completed-parent-issue.ts",
    "dev": "eve dev",
    "list-app-repositories": "node --env-file-if-exists=.env.local src/cli/list-app-repositories.ts",
    "remove-expired-release-age-exclusions": "node --env-file-if-exists=.env.local src/cli/remove-expired-release-age-exclusions.ts",
    "start": "eve start",
    "sync-devcontainer-lock-file": "node --env-file-if-exists=.env.local src/cli/sync-devcontainer-lock-file.ts",
    "test": "vitest run",
    "typecheck": "tsc"
  },
  "dependencies": {
    "@publira/devcontainer": "workspace:*",
    "@publira/github": "workspace:*",
    "@publira/maintenance-policies": "workspace:*",
    "@publira/npm-registry": "workspace:*",
    "@publira/pnpm-workspace": "workspace:*",
    "ai": "7.0.127",
    "eve": "0.71.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@publira/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
